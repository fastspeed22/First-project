# SHARED CONTINUATION (every outpost path that survives ends up here)
# If followed is True, something is following the player.
# If followed is False, they got away clean.
# ---------------------------------------------------------------

def continue_story():
    if followed:
        confrontation()
    else:
        safe_ending()


